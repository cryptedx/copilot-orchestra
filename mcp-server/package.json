{
  "name": "copilot-orchestra-mcp",
  "version": "1.0.0",
  "description": "MCP server for GitHub Copilot Orchestra workflow elicitation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "copilot-orchestra-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "mock:elicitation": "npm run build && node dist/mock-client.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "copilot",
    "orchestra",
    "workflow"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "typescript": "^5.3.0",
    "vitest": "^4.0.10"
  }
}
